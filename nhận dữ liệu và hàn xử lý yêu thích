export default function BookCard({ book, isFavorite, onToggleFavorite }) {
  return (
    <article className="book-card">
      <div>
        <span className="book-code">Mã: {book.id}</span>
        <h3 className="book-title">{book.title}</h3>
        <p className="book-meta">Tác giả: {book.author}</p>
        <p className="book-meta">Năm xuất bản: {book.year}</p>
        <span className="genre-tag">{book.genre}</span>
      </div>

      <div className="card-actions">
        <button
          type="button"
          className={isFavorite ? "btn btn-fav active" : "btn btn-fav"}
          onClick={() => onToggleFavorite(book.id)}
        >
          {isFavorite ? "❤️ Đã thích" : "🤍 Yêu thích"}
        </button>
      </div>
    </article>
  );
}
