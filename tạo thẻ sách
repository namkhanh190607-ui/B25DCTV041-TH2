import { Book } from "./types";

export function renderGenreOptions(
  books: Book[],
  filterSelect: HTMLSelectElement,
  formSelect: HTMLSelectElement
): void {
  const uniqueGenres = Array.from(new Set(books.map((b) => b.genre)));

  // Cập nhật dropdown lọc
  const currentFilter = filterSelect.value;
  filterSelect.innerHTML = "";
  const allOption = document.createElement("option");
  allOption.value = "all";
  allOption.textContent = "Tất cả thể loại";
  filterSelect.appendChild(allOption);

  uniqueGenres.forEach((genre) => {
    const opt = document.createElement("option");
    opt.value = genre;
    opt.textContent = genre;
    filterSelect.appendChild(opt);
  });
  if (uniqueGenres.includes(currentFilter)) {
    filterSelect.value = currentFilter;
  }

  // Cập nhật dropdown trong form thêm sách
  const currentFormGenre = formSelect.value;
  formSelect.innerHTML = "";
  const placeholderOpt = document.createElement("option");
  placeholderOpt.value = "";
  placeholderOpt.textContent = "-- Chọn thể loại --";
  formSelect.appendChild(placeholderOpt);

  uniqueGenres.forEach((genre) => {
    const opt = document.createElement("option");
    opt.value = genre;
    opt.textContent = genre;
    formSelect.appendChild(opt);
  });
  if (uniqueGenres.includes(currentFormGenre)) {
    formSelect.value = currentFormGenre;
  }
}

export function createBookCardElement(book: Book, isFavorite: boolean): HTMLElement {
  const card = document.createElement("article");
  card.className = "book-card";
  card.dataset.id = book.id;

  const infoDiv = document.createElement("div");

  const codeEl = document.createElement("span");
  codeEl.className = "book-code";
  codeEl.textContent = `Mã: ${book.id}`;

  const titleEl = document.createElement("h3");
  titleEl.className = "book-title";
  titleEl.textContent = book.title;

  const authorEl = document.createElement("p");
  authorEl.className = "book-meta";
  authorEl.textContent = `Tác giả: ${book.author}`;

  const yearEl = document.createElement("p");
  yearEl.className = "book-meta";
  yearEl.textContent = `Năm xuất bản: ${book.year}`;

  const genreEl = document.createElement("span");
  genreEl.className = "genre-tag";
  genreEl.textContent = book.genre;

  infoDiv.append(codeEl, titleEl, authorEl, yearEl, genreEl);

  const actionsDiv = document.createElement("div");
  actionsDiv.className = "card-actions";

  const favBtn = document.createElement("button");
  favBtn.type = "button";
  favBtn.className = isFavorite ? "btn btn-fav active" : "btn btn-fav";
  favBtn.dataset.action = "favorite";
  favBtn.textContent = isFavorite ? "❤️ Đã thích" : "🤍 Yêu thích";

  const deleteBtn = document.createElement("button");
  deleteBtn.type = "button";
  deleteBtn.className = "btn btn-delete";
  deleteBtn.dataset.action = "delete";
  deleteBtn.textContent = "🗑️ Xóa";

  actionsDiv.append(favBtn, deleteBtn);
  card.append(infoDiv, actionsDiv);

  return card;
}
